# @currentEnv=$APP_ENV
# ---

# Runtime environment name
# @type=enum(development, test, production)
APP_ENV=development

# Public origin used for absolute URLs and callbacks
# @type=url
APP_URL=http://localhost:3000

# PostgreSQL connection string for the future data layer
# @type=string(startsWith=postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/learning_makes_difference

# Cookie/session signing secret for server-managed auth
# @type=string(min=32)
SESSION_SECRET=development-session-secret-change-me

# Structured log verbosity
# @type=enum(debug, info, warn, error)
LOG_LEVEL=info
