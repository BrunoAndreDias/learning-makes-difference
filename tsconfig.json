{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client", "vitest/globals"],
    "verbatimModuleSyntax": false
  },
  "include": [
    ".sandcastle/main.ts",
    "src",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.db.config.ts"
  ]
}
